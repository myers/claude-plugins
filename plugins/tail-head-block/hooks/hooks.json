{
  "description": "Blocks piping Bash tool output to | tail or | head, which buffer until EOF and hide progress",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-tail-head.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
